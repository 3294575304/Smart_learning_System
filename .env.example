# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zhixue_classroom?schema=public"

# Required by database and HTTP integration tests; there is no DATABASE_URL fallback.
# Use a dedicated PostgreSQL database whose name contains a separate "test" marker.
# It must differ from DATABASE_URL and must not point to production or staging.
# Never commit real database credentials.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zhixue_classroom_test?schema=public"

# Local private upload storage. Defaults to .data/uploads when empty.
# Do not point this at public/ or commit uploaded files.
LOCAL_UPLOAD_ROOT=""
# Versioned course/class upload limits. Empty values use safe defaults:
# 5 MB per file and 1000 roster data rows, not counting the header row.
COURSE_FILE_MAX_SIZE_BYTES=""
STUDENT_ROSTER_MAX_ROWS=""

# Development-only seed credentials. Change them outside local development.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_TEACHER_EMAIL="teacher@example.com"
SEED_TEACHER_PASSWORD="Teacher123!"
SEED_STUDENT_EMAIL="student@example.com"
SEED_STUDENT_PASSWORD="Student123!"

# AI analysis. Keep mock for local development; use openai-compatible in production.
AI_PROVIDER="mock"
# Use "chat-completions" for DeepSeek/OpenAI-compatible chat endpoints or
# "responses" for the OpenAI Responses API.
AI_API_TYPE="chat-completions"
# Optional: enabled/disabled. Empty automatically disables DeepSeek V4's
# default thinking mode for deterministic JSON tasks; other providers omit it.
AI_THINKING_MODE=""
AI_MODEL="mock-student-analyzer-v1"
AI_BASE_URL="https://api.example.com/v1"
AI_API_KEY=""
AI_TIMEOUT_MS="8000"
# Milliseconds. Long structured syllabus output defaults to 180 seconds.
SYLLABUS_AI_TIMEOUT_MS="180000"
# Defaults to 8192. Increase for long syllabus JSON when the configured model
# supports it; the application accepts up to 384000 and forwards the value.
SYLLABUS_AI_MAX_COMPLETION_TOKENS="8192"
# Use a random secret with at least 16 characters and never expose it to clients.
AI_PSEUDONYM_SALT="change-this-local-pseudonym-salt"

# Protects the internal assignment reminder endpoint. Use a random value with
# at least 32 characters and never expose it to browser code.
NOTIFICATION_JOB_SECRET="change-this-local-notification-job-secret"

# Protects all /api/internal/background-jobs endpoints. Use a different random
# value with at least 32 characters. This secret is server/worker-only.
BACKGROUND_JOB_WORKER_SECRET="change-this-local-background-worker-secret"
# During rotation, set the old value here until every worker uses the new secret.
BACKGROUND_JOB_WORKER_PREVIOUS_SECRET=""

# Remote isolated executor. The web process only calls this API and must never
# execute submitted source code locally. Leave empty until a real sandbox is
# deployed and npm run test:sandbox-capabilities passes against it.
SANDBOX_EXECUTOR_URL=""
SANDBOX_EXECUTOR_API_KEY=""
SANDBOX_EXECUTOR_PREVIOUS_API_KEY=""
SANDBOX_EXECUTOR_MAX_QUEUE_DEPTH="100"

# Independent programming judge worker. It runs outside the Next.js process.
APPLICATION_INTERNAL_URL="http://127.0.0.1:3000"
PROGRAMMING_JUDGE_WORKER_ID=""
PROGRAMMING_JUDGE_POLL_INTERVAL_MS="1000"
PROGRAMMING_JUDGE_LEASE_DURATION_MS="30000"
PROGRAMMING_JUDGE_RECOVERY_INTERVAL_MS="30000"
