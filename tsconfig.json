{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".data/next-practice-history-20261028/types/**/*.ts",
    ".data/next-practice-management-20261028/types/**/*.ts",
    ".data/next-practice-management-verified-20261028/types/**/*.ts",
    ".data/next-student-acceptance-20261028/types/**/*.ts",
    ".data/next-student-acceptance-final-20261028/types/**/*.ts",
    ".data/next-student-acceptance-verified-20261028/types/**/*.ts",
    ".data/next-student-home-stage2-20261027/types/**/*.ts",
    ".data/next-student-scoring-20261028/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
