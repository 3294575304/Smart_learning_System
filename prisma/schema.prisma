  conceptSnapshots    CourseRecommendationConceptSnapshot[]
  conceptEvidences    RecommendationConceptEvidence[]
  programmingAttempts ProgrammingAttempt[]

  @@unique([studentId, questionId, cycleKey])
  @@index([studentId, status, priority, createdAt])
  @@index([knowledgePointId, status])
  @@index([analysisId])
  @@index([courseCycleId, priority])
  @@index([targetConceptId, status])
  @@index([createdAt])
}

model StudentSelfReflection {
  id              String                      @id @default(cuid())
  studentId       String
  courseId        String
  inputText       String                      @db.Text
  summary         String                      @db.Text
  goals           String[]                    @default([])
  difficulties    String[]                    @default([])
  learningHabits  String[]                    @default([])
  practiceRequest Json?
  status          StudentSelfReflectionStatus @default(DRAFT)
  provider        String?
  model           String?
  promptVersion   String                      @db.VarChar(100)
  fallbackUsed    Boolean                     @default(false)
  confirmedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  student User   @relation("StudentSelfReflectionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([studentId, courseId, status, createdAt])
  @@index([courseId, status, createdAt])
}

model RecommendationPracticeAnswer {
  id                    String   @id @default(cuid())
  recommendationId      String   @unique
  questionId            String
  idempotencyKey        String   @unique
  assessmentRevisionKey String?  @db.VarChar(191)
  textAnswer            String?  @db.Text
  booleanAnswer         Boolean?
  selectedOptionIds     String[] @default([])
  responseTimeMs        Int?
  score                 Decimal  @db.Decimal(8, 2)
  maxScore              Decimal  @db.Decimal(8, 2)
  isCorrect             Boolean
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  recommendation   PersonalizedRecommendation      @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  question         Question                        @relation("RecommendationPracticeQuestion", fields: [questionId], references: [id], onDelete: Restrict)
  wrongQuestion    WrongQuestion?                  @relation("RecommendationWrongAnswer")
  conceptEvidences RecommendationConceptEvidence[]

  @@index([questionId, isCorrect])
  @@index([createdAt])
}

model AITutoringRecord {
  id               String         @id @default(cuid())
  requestKey       String         @unique
  studentId        String
  questionId       String
  knowledgePointId String?
  status           AIRecordStatus @default(PENDING)
  prompt           String         @db.Text
  answer           String?        @db.Text
  explanationSteps String[]       @default([])
  hints            String[]       @default([])
  provider         String?
  model            String?
  promptVersion    String
  retryCount       Int            @default(0)
  fallbackUsed     Boolean        @default(false)
  confidence       Decimal?       @db.Decimal(5, 4)
  safetyFlagged    Boolean        @default(false)
  inputContext     Json?
  rawResponse      Json?
  errorCode        String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  student        User            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  knowledgePoint KnowledgePoint? @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)

  @@index([studentId, questionId, createdAt])
  @@index([status, createdAt])
  @@index([knowledgePointId, createdAt])
}
