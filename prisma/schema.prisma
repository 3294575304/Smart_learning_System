  @@index([batchId, executionStatus])
  @@index([batchId, studentNo])
  @@index([batchId, rowKey])
  @@index([matchedUserId])
  @@index([matchedMembershipId])
  @@index([createdUserId])
  @@index([createdMembershipId])
  @@index([studentIdentityId])
}

model KnowledgePoint {
