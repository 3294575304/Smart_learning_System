model StudentImportRow {
  id                  String                       @id @default(cuid())
  batchId             String
  rowNumber           Int
  previewStatus       StudentImportPreviewStatus   @default(PENDING)
  executionStatus     StudentImportExecutionStatus @default(PENDING)
  rowKey              String                       @db.VarChar(191)
  sourceRow           Json
