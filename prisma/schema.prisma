generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_ENABLED
  USER_DISABLED
  SYSTEM_CONFIG_UPDATED
  MAINTENANCE_MODE_ENABLED
  MAINTENANCE_MODE_DISABLED
  AI_FEATURE_ENABLED
  AI_FEATURE_DISABLED
  ANNOUNCEMENT_CREATED
  ANNOUNCEMENT_UPDATED
  ANNOUNCEMENT_PUBLISHED
  SUBMISSION_GRADING_COMPLETED
  ASSIGNMENT_RESULTS_PUBLISHED
  QUESTION_MADE_PUBLIC
  QUESTION_MADE_PRIVATE
  QUESTION_DISABLED
  CLASSROOM_CLOSED_BY_ADMIN
  CLASSROOM_DISSOLVED
  COURSE_TEMPLATE_CREATED
  COURSE_TEMPLATE_UPDATED
  COURSE_TEMPLATE_ENABLED
  COURSE_TEMPLATE_DISABLED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_DELETED
  COURSE_CLASSROOM_LINKED
  COURSE_CLASSROOM_UNLINKED
  COURSE_FILE_UPLOADED
  COURSE_FILE_DOWNLOADED
  STUDENT_IMPORT_PREVIEWED
  STUDENT_IMPORT_MAPPING_CONFIRMED
  STUDENT_IMPORT_EXECUTED
  STUDENT_IMPORT_ACCOUNT_SHEET_DOWNLOADED
  STUDENT_IMPORT_FAILED
  SYLLABUS_REVIEW_SAVED
  SYLLABUS_STRUCTURE_PUBLISHED
  KNOWLEDGE_GRAPH_GENERATED
  KNOWLEDGE_GRAPH_REVIEW_SAVED
  KNOWLEDGE_GRAPH_PUBLISHED
  QUESTION_GRAPH_BINDINGS_UPDATED
  QUESTION_GRAPH_BINDINGS_CLEARED
}

enum QuestionGraphBindingType {
  PRIMARY
  SECONDARY
}

enum AssignmentConceptResolutionStatus {
  RESOLVED
  NO_CURRENT_PUBLISHED_GRAPH
  MISSING_FROM_PUBLISHED_GRAPH
}

enum ConceptEvidenceStatus {
  VALID
  REVOKED
}

enum ConceptEvidenceGradingSource {
  AUTO_GRADING
  MANUAL_GRADING
}

enum CourseConceptMasteryLevel {
  NEEDS_SUPPORT
  DEVELOPING
  MASTERED
}

enum AuditTargetType {
  USER
  SYSTEM_CONFIG
  ANNOUNCEMENT
  SUBMISSION
  ASSIGNMENT
  QUESTION
  CLASSROOM
  COURSE
  COURSE_TEMPLATE
  COURSE_FILE
  STUDENT_IMPORT_BATCH
  SYLLABUS_REVIEW
  SYLLABUS_STRUCTURE
  KNOWLEDGE_GRAPH_DRAFT
  KNOWLEDGE_GRAPH_REVIEW
  KNOWLEDGE_GRAPH_VERSION
}

enum NotificationType {
  ASSIGNMENT_PUBLISHED
  ASSIGNMENT_DUE_SOON
  ASSIGNMENT_GRADED
  LEARNING_ANALYSIS_READY
  RECOMMENDATION_READY
  SYSTEM_ANNOUNCEMENT
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationSourceType {
  ASSIGNMENT
  SUBMISSION
  AI_ANALYSIS
  RECOMMENDATION_CYCLE
  ANNOUNCEMENT
}

enum AnnouncementTargetType {
  ALL
  ADMIN
  TEACHER
  STUDENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum NotificationJobType {
  ASSIGNMENT_DUE_REMINDER
}

enum NotificationJobStatus {
  SUCCEEDED
  PARTIAL_FAILED
  FAILED
}

enum ClassroomStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CourseFileKind {
  SYLLABUS
  MATERIAL
  PRACTICE_GUIDE
  REPORT_TEMPLATE
  IMPORT_SOURCE
  ACCOUNT_SHEET
  OTHER
}

enum SyllabusParseStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum KnowledgeGraphStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum KnowledgeGraphNodeType {
  COURSE
  CHAPTER
  KNOWLEDGE_POINT
}

enum KnowledgeGraphRelationType {
  CONTAINS
  PREREQUISITE
  RELATED
}

enum KnowledgeGraphSourceType {
  SYLLABUS
  AI_INFERRED
  TEACHER
}

enum StudentImportBatchStatus {
  UPLOADED
  PREVIEW_READY
  CONFIRMED
  PROCESSING
  SUCCEEDED
  PARTIAL_FAILED
  FAILED
  CANCELLED
}

enum StudentImportPreviewStatus {
  PENDING
  NEW_USER
  EXISTING_USER
  ALREADY_ENROLLED
  COURSE_MISMATCH
  INVALID
  DUPLICATE
}

enum StudentImportExecutionStatus {
  PENDING
  APPLIED
  FAILED
  SKIPPED
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum StudentIdentityStatus {
  PENDING
  ACTIVATED
  DISABLED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum QuestionVisibility {
  PRIVATE
  PUBLIC
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  PENDING_REVIEW
  GRADED
  PUBLISHED
  WITHDRAWN
}

enum GradingStatus {
  UNGRADED
  AUTO_GRADED
  MANUAL_REVIEW_REQUIRED
  GRADED
}

enum MasteryLevel {
  NOT_STARTED
  BEGINNER
  DEVELOPING
  PROFICIENT
  MASTERED
}

enum MasteryTrend {
  UNKNOWN
  UP
  STABLE
  DOWN
}

enum AIRecordStatus {
  PENDING
  SUCCEEDED
  FAILED
  FALLBACK
}

enum AIAnalysisScope {
  STUDENT
  CLASSROOM
}

enum AIInsightType {
  STRENGTH
  WEAKNESS
  RISK
  SUGGESTION
}

enum RiskLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationSource {
  RULE
  AI
  HYBRID
}

enum RecommendationStatus {
  PENDING
  STARTED
  COMPLETED
  DISMISSED
  EXPIRED
}

model User {
  id                 String     @id @default(cuid())
  email              String?    @unique
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  profile                       UserProfile?
  taughtClassrooms              Classroom[]                        @relation("ClassroomTeacher")
  taughtCourses                 Course[]                           @relation("CourseTeacher")
  classMemberships              ClassMembership[]                  @relation("ClassMembershipStudent")
  createdQuestions              Question[]                         @relation("QuestionCreator")
  createdKnowledgePoints        KnowledgePoint[]                   @relation("KnowledgePointCreator")
  assignments                   Assignment[]                       @relation("AssignmentTeacher")
  submissions                   Submission[]                       @relation("SubmissionStudent")
  gradedAnswers                 StudentAnswer[]                    @relation("StudentAnswerGrader")
  wrongQuestions                WrongQuestion[]                    @relation("WrongQuestionStudent")
  knowledgeMasteries            StudentKnowledgeMastery[]          @relation("MasteryStudent")
  requestedAIAnalyses           AIAnalysis[]                       @relation("AIAnalysisRequester")
  studentAIAnalyses             AIAnalysis[]                       @relation("AIAnalysisStudent")
  personalizedRecommendations   PersonalizedRecommendation[]
  aiTutoringRecords             AITutoringRecord[]
  authSessions                  AuthSession[]
  auditLogs                     AuditLog[]                         @relation("AuditActor")
  updatedSystemConfigs          SystemConfig[]                     @relation("SystemConfigUpdater")
  notifications                 Notification[]                     @relation("NotificationRecipient")
  createdAnnouncements          Announcement[]                     @relation("AnnouncementCreator")
  publishedAnnouncements        Announcement[]                     @relation("AnnouncementPublisher")
  uploadedCourseFiles           CourseFileVersion[]                @relation("CourseFileUploadedBy")
  uploadedCourseSyllabi         CourseSyllabus[]                   @relation("CourseSyllabusUploadedBy")
  requestedSyllabusParses       SyllabusParseDraft[]               @relation("SyllabusParseRequestedBy")
  syllabusReviewRevisions       SyllabusReviewRevision[]           @relation("SyllabusReviewEditedBy")
  publishedSyllabusStructures   PublishedSyllabusStructure[]       @relation("SyllabusStructurePublishedBy")
  requestedKnowledgeGraphDrafts KnowledgeGraphDraft[]              @relation("KnowledgeGraphDraftRequestedBy")
  knowledgeGraphReviewRevisions KnowledgeGraphReviewRevision[]     @relation("KnowledgeGraphReviewEditedBy")
  publishedKnowledgeGraphs      PublishedKnowledgeGraphVersion[]   @relation("KnowledgeGraphPublishedBy")
  createdQuestionGraphBindings  QuestionKnowledgeGraphBinding[]    @relation("QuestionGraphBindingCreator")
  conceptAnswerEvidences        StudentAnswerConceptEvidence[]     @relation("ConceptEvidenceStudent")
  courseConceptMasteryStates    StudentCourseConceptMasteryState[] @relation("CourseConceptMasteryStudent")
  createdStudentImportBatches   StudentImportBatch[]               @relation("StudentImportBatchCreatedBy")
  matchedStudentImportRows      StudentImportRow[]                 @relation("StudentImportMatchedUser")
  createdStudentImportRows      StudentImportRow[]                 @relation("StudentImportCreatedUser")
  studentIdentity               StudentIdentity?

  @@index([role, status])
  @@index([mustChangePassword])
  @@index([createdAt])
}

model Notification {
  id               String                 @id @default(cuid())
  recipientId      String
  type             NotificationType
  title            String                 @db.VarChar(100)
  content          String                 @db.Text
  priority         NotificationPriority   @default(NORMAL)
  actionUrl        String?                @db.VarChar(500)
  sourceType       NotificationSourceType
  sourceId         String                 @db.VarChar(128)
  deduplicationKey String                 @db.VarChar(191)
  readAt           DateTime?
  expiresAt        DateTime?
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([recipientId, deduplicationKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([expiresAt])
  @@index([sourceType, sourceId])
}

model Announcement {
  id            String                 @id @default(cuid())
  title         String                 @db.VarChar(100)
  content       String                 @db.Text
  targetType    AnnouncementTargetType
  status        AnnouncementStatus     @default(DRAFT)
  createdById   String
  publishedById String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  createdBy   User  @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User? @relation("AnnouncementPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetType, status])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([createdById])
  @@index([publishedById])
}

model NotificationJobRun {
  id           String                @id @default(cuid())
  type         NotificationJobType
  status       NotificationJobStatus
  scannedCount Int                   @default(0)
  createdCount Int                   @default(0)
  skippedCount Int                   @default(0)
  failedCount  Int                   @default(0)
  errorSummary String?               @db.VarChar(500)
  startedAt    DateTime              @default(now())
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([type, startedAt])
  @@index([status, startedAt])
}

model SystemConfig {
  id                        String   @id @default(cuid())
  singletonKey              String   @unique @default("default")
  platformName              String   @default("智学课堂")
  platformAnnouncement      String   @default("") @db.Text
  maintenanceMode           Boolean  @default(false)
  maintenanceMessage        String   @default("系统维护中，请稍后再试。")
  allowSelfRegistration     Boolean  @default(true)
  assignmentDefaultDueDays  Int      @default(7)
  assignmentAutosaveDelayMs Int      @default(900)
  aiAnalysisEnabled         Boolean  @default(true)
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  updatedBy User? @relation("SystemConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model AuditLog {
  id         String          @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType AuditTargetType
  targetId   String
  summary    String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  avatarUrl   String?
  bio         String?  @db.Text
  phone       String?
  studentNo   String?  @unique
  teacherNo   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

model StudentIdentity {
  id        String                @id @default(cuid())
  studentNo String                @unique @db.VarChar(50)
  name      String                @db.VarChar(100)
  email     String?               @db.VarChar(254)
  status    StudentIdentityStatus @default(PENDING)
  userId    String?               @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user        User?                                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments StudentIdentityClassroomAssignment[]
  importRows  StudentImportRow[]

  @@index([status, createdAt])
}

model StudentIdentityClassroomAssignment {
  id                String   @id @default(cuid())
  studentIdentityId String
  classroomId       String
  sourceBatchId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentIdentity StudentIdentity     @relation(fields: [studentIdentityId], references: [id], onDelete: Restrict)
  classroom       Classroom           @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  sourceBatch     StudentImportBatch? @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@unique([studentIdentityId, classroomId])
  @@index([classroomId])
  @@index([sourceBatchId])
}

model CourseTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  version     String   @default("1.0")
  isBuiltin   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@index([name, isActive])
}

model Course {
  id                                      String       @id @default(cuid())
  templateId                              String
  teacherId                               String
  courseNo                                String       @db.VarChar(50)
  term                                    String       @db.VarChar(50)
  name                                    String       @db.VarChar(100)
  description                             String?      @db.Text
  status                                  CourseStatus @default(DRAFT)
  publishedAt                             DateTime?
  archivedAt                              DateTime?
  currentPublishedSyllabusStructureId     String?      @unique
  currentPublishedKnowledgeGraphVersionId String?      @unique
  createdAt                               DateTime     @default(now())
  updatedAt                               DateTime     @updatedAt

  template                              CourseTemplate                      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  teacher                               User                                @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  classrooms                            Classroom[]                         @relation("ClassroomCourse")
  courseFileVersions                    CourseFileVersion[]                 @relation("CourseFileCourse")
  syllabi                               CourseSyllabus[]                    @relation("CourseSyllabusCourse")
  syllabusParseDrafts                   SyllabusParseDraft[]
  syllabusReviewRevisions               SyllabusReviewRevision[]
  publishedSyllabusStructures           PublishedSyllabusStructure[]        @relation("PublishedSyllabusStructureCourse")
  currentPublishedSyllabusStructure     PublishedSyllabusStructure?         @relation("CurrentPublishedSyllabusStructure", fields: [currentPublishedSyllabusStructureId], references: [id], onDelete: SetNull)
  knowledgeGraphDrafts                  KnowledgeGraphDraft[]
  knowledgeGraphReviewRevisions         KnowledgeGraphReviewRevision[]
  publishedKnowledgeGraphVersions       PublishedKnowledgeGraphVersion[]    @relation("PublishedKnowledgeGraphCourse")
  currentPublishedKnowledgeGraphVersion PublishedKnowledgeGraphVersion?     @relation("CurrentPublishedKnowledgeGraph", fields: [currentPublishedKnowledgeGraphVersionId], references: [id], onDelete: SetNull)
  knowledgeGraphConcepts                KnowledgeGraphConcept[]
  questionGraphBindingSets              QuestionKnowledgeGraphBindingSet[]
  questionGraphBindings                 QuestionKnowledgeGraphBinding[]
  assignmentQuestionConceptSnapshots    AssignmentQuestionConceptSnapshot[]
  conceptAnswerEvidences                StudentAnswerConceptEvidence[]
  studentConceptMasteryStates           StudentCourseConceptMasteryState[]
  studentImportBatches                  StudentImportBatch[]                @relation("StudentImportCourse")

  @@unique([teacherId, courseNo, term])
  @@index([templateId, status, createdAt])
  @@index([teacherId, status, createdAt])
  @@index([term, courseNo])
}

model CourseFileVersion {
  id               String         @id @default(cuid())
  courseId         String?
  classroomId      String?
  uploadedById     String
  fileKind         CourseFileKind
  fileKey          String         @db.VarChar(100)
  title            String         @db.VarChar(120)
  versionNumber    Int            @default(1)
  originalFileName String         @db.VarChar(255)
  storageKey       String         @unique @db.VarChar(191)
  mimeType         String         @db.VarChar(100)
  sizeBytes        Int
  checksumSha256   String         @db.Char(64)
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  course                  Course?              @relation("CourseFileCourse", fields: [courseId], references: [id], onDelete: Restrict)
  classroom               Classroom?           @relation("CourseFileClassroom", fields: [classroomId], references: [id], onDelete: Restrict)
  uploadedBy              User                 @relation("CourseFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  sourceImportBatches     StudentImportBatch[] @relation("StudentImportSourceFile")
  accountSheetImportBatch StudentImportBatch?  @relation("StudentImportAccountSheet")

  @@unique([courseId, fileKind, fileKey, versionNumber])
  @@unique([classroomId, fileKind, fileKey, versionNumber])
  @@index([courseId, fileKind, createdAt])
  @@index([courseId, uploadedById, createdAt])
  @@index([classroomId, fileKind, createdAt])
  @@index([classroomId, uploadedById, createdAt])
  @@index([checksumSha256])
}

model CourseSyllabus {
  id             String   @id @default(cuid())
  courseId       String
  uploadedById   String
  versionNumber  Int      @default(1)
  originalName   String   @db.VarChar(255)
  mimeType       String   @db.VarChar(100)
  sizeBytes      Int
  checksumSha256 String?  @db.Char(64)
  storageKey     String   @unique @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course              Course                       @relation("CourseSyllabusCourse", fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy          User                         @relation("CourseSyllabusUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  parseDrafts         SyllabusParseDraft[]
  reviewRevisions     SyllabusReviewRevision[]
  publishedStructures PublishedSyllabusStructure[]

  @@unique([courseId, versionNumber])
  @@index([courseId, createdAt])
  @@index([uploadedById])
}

model SyllabusParseDraft {
  id                    String              @id @default(cuid())
  courseId              String
  syllabusId            String
  requestedById         String
  status                SyllabusParseStatus @default(PENDING)
  parserVersion         String              @db.VarChar(50)
  promptVersion         String              @db.VarChar(50)
  ruleVersion           String              @db.VarChar(50)
  provider              String?             @db.VarChar(100)
  model                 String?             @db.VarChar(150)
  retryCount            Int                 @default(0)
  executionCount        Int                 @default(0)
  structuredResult      Json?
  extractedTextMetadata Json?
  errorCode             String?             @db.VarChar(100)
  attemptId             String?             @db.VarChar(36)
  providerRequestId     String?             @db.VarChar(191)
  finishReason          String?             @db.VarChar(50)
  promptTokens          Int?
  completionTokens      Int?
  totalTokens           Int?
  responseLength        Int?
  providerDurationMs    Int?
  jsonParseDurationMs   Int?
  validationDurationMs  Int?
  errorPhase            String?             @db.VarChar(30)
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  course              Course                       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  syllabus            CourseSyllabus               @relation(fields: [syllabusId], references: [id], onDelete: Restrict)
  requestedBy         User                         @relation("SyllabusParseRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewRevisions     SyllabusReviewRevision[]
  publishedStructures PublishedSyllabusStructure[]

  @@unique([syllabusId, parserVersion])
  @@index([courseId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([attemptId])
}

model SyllabusReviewRevision {
  id             String   @id @default(cuid())
  courseId       String
  syllabusId     String
  parseDraftId   String
  editedById     String
  revisionNumber Int
  structureJson  Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course             Course                      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  syllabus           CourseSyllabus              @relation(fields: [syllabusId], references: [id], onDelete: Restrict)
  parseDraft         SyllabusParseDraft          @relation(fields: [parseDraftId], references: [id], onDelete: Restrict)
  editedBy           User                        @relation("SyllabusReviewEditedBy", fields: [editedById], references: [id], onDelete: Restrict)
  publishedStructure PublishedSyllabusStructure?

  @@unique([parseDraftId, revisionNumber])
  @@index([courseId, createdAt])
  @@index([editedById, createdAt])
}

model PublishedSyllabusStructure {
  id               String   @id @default(cuid())
  courseId         String
  syllabusId       String
  parseDraftId     String
  reviewRevisionId String   @unique
  publishedById    String
  versionNumber    Int
  structureJson    Json
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course                        Course                           @relation("PublishedSyllabusStructureCourse", fields: [courseId], references: [id], onDelete: Restrict)
  currentForCourse              Course?                          @relation("CurrentPublishedSyllabusStructure")
  syllabus                      CourseSyllabus                   @relation(fields: [syllabusId], references: [id], onDelete: Restrict)
  parseDraft                    SyllabusParseDraft               @relation(fields: [parseDraftId], references: [id], onDelete: Restrict)
  reviewRevision                SyllabusReviewRevision           @relation(fields: [reviewRevisionId], references: [id], onDelete: Restrict)
  publishedBy                   User                             @relation("SyllabusStructurePublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  knowledgeGraphDrafts          KnowledgeGraphDraft[]
  knowledgeGraphReviewRevisions KnowledgeGraphReviewRevision[]
  publishedKnowledgeGraphs      PublishedKnowledgeGraphVersion[]

  @@unique([courseId, versionNumber])
  @@index([courseId, publishedAt])
  @@index([syllabusId])
  @@index([publishedById, publishedAt])
}

model KnowledgeGraphDraft {
  id                         String               @id @default(cuid())
  courseId                   String
  sourceSyllabusStructureId  String
  requestedById              String
  status                     KnowledgeGraphStatus @default(PENDING)
  generatorVersion           String               @db.VarChar(50)
  promptVersion              String               @db.VarChar(50)
  ruleVersion                String               @db.VarChar(50)
  provider                   String?              @db.VarChar(100)
  model                      String?              @db.VarChar(150)
  retryCount                 Int                  @default(0)
  executionCount             Int                  @default(0)
  progress                   Int                  @default(0)
  successCount               Int                  @default(0)
  failureCount               Int                  @default(0)
  deterministicStructureJson Json?
  aiInferenceJson            Json?
  generatedStructureJson     Json?
  errorCode                  String?              @db.VarChar(100)
  startedAt                  DateTime?
  completedAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  course                  Course                           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sourceSyllabusStructure PublishedSyllabusStructure       @relation(fields: [sourceSyllabusStructureId], references: [id], onDelete: Restrict)
  requestedBy             User                             @relation("KnowledgeGraphDraftRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewRevisions         KnowledgeGraphReviewRevision[]
  publishedVersions       PublishedKnowledgeGraphVersion[]

  @@unique([sourceSyllabusStructureId, generatorVersion])
  @@index([courseId, status, createdAt])
  @@index([requestedById, createdAt])
}

model KnowledgeGraphReviewRevision {
