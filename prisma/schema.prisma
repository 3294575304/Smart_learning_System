  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  graphVersion PublishedKnowledgeGraphVersion @relation(fields: [graphVersionId], references: [id], onDelete: Restrict)
  fromNode     PublishedKnowledgeGraphNode    @relation("KnowledgeGraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Restrict)
  toNode       PublishedKnowledgeGraphNode    @relation("KnowledgeGraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Restrict)

  @@unique([graphVersionId, relationType, fromNodeId, toNodeId])
  @@index([graphVersionId, relationType])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model Classroom {
