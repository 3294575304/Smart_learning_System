  importedRows              Int                      @default(0)
  failedRows                Int                      @default(0)
  previewedAt               DateTime?
  confirmedAt               DateTime?
  startedAt                 DateTime?
  completedAt               DateTime?
  accountSheetDownloadedAt  DateTime?
  accountSheetDownloadCount Int                      @default(0)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  course              Course                               @relation("StudentImportCourse", fields: [courseId], references: [id], onDelete: Restrict)
