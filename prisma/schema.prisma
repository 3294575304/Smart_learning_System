  status            QuestionStatus     @default(DRAFT)
  explanation       String             @db.Text
  tags              String[]           @default([])
  correctBoolean    Boolean?
  referenceAnswer   String?            @db.Text
  acceptableAnswers String[]           @default([])
  isCaseSensitive   Boolean            @default(false)
  gradingConfig     Json?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  creator                      User                                @relation("QuestionCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  options                      QuestionOption[]
