  questionBindings            QuestionKnowledgeGraphBinding[]
  assignmentQuestionSnapshots AssignmentQuestionConceptSnapshot[]
  answerEvidences             StudentAnswerConceptEvidence[]
  masteryEntries              StudentCourseConceptMasteryEntry[]

  @@unique([courseId, stableKey])
  @@index([courseId, createdAt])
}

model PublishedKnowledgeGraphNode {
  id                 String                   @id @default(cuid())
  graphVersionId     String
  conceptId          String
  nodeType           KnowledgeGraphNodeType
  code               String                   @db.VarChar(100)
  name               String                   @db.VarChar(300)
  description        String?                  @db.Text
  importance         String?                  @db.VarChar(30)
  isKeyTopic         Boolean                  @default(false)
  isDifficultTopic   Boolean                  @default(false)
  objectiveMappings  Json?
  assessmentMappings Json?
  sourceType         KnowledgeGraphSourceType
  sourceRefs         Json
  confidence         Decimal?                 @db.Decimal(5, 4)
  sourcePath         String?                  @db.VarChar(500)
  sortOrder          Int
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  graphVersion                PublishedKnowledgeGraphVersion      @relation(fields: [graphVersionId], references: [id], onDelete: Restrict)
  concept                     KnowledgeGraphConcept               @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  outgoingEdges               PublishedKnowledgeGraphEdge[]       @relation("KnowledgeGraphEdgeFrom")
  incomingEdges               PublishedKnowledgeGraphEdge[]       @relation("KnowledgeGraphEdgeTo")
  sourceQuestionBindings      QuestionKnowledgeGraphBinding[]     @relation("QuestionGraphBindingSourceNode")
  sourceAssignmentSnapshots   AssignmentQuestionConceptSnapshot[] @relation("AssignmentConceptSnapshotSourceNode")
  resolvedAssignmentSnapshots AssignmentQuestionConceptSnapshot[] @relation("AssignmentConceptSnapshotResolvedNode")

  @@unique([graphVersionId, code])
  @@unique([graphVersionId, conceptId])
  @@index([graphVersionId, nodeType, sortOrder])
  @@index([conceptId])
}

model PublishedKnowledgeGraphEdge {
  id             String                     @id @default(cuid())
  graphVersionId String
  fromNodeId     String
  toNodeId       String
  relationType   KnowledgeGraphRelationType
  description    String?                    @db.Text
