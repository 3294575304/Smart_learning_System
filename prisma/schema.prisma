  createdAt                           DateTime                      @default(now())
  updatedAt                           DateTime                      @updatedAt

  student                           User                              @relation("ConceptEvidenceStudent", fields: [studentId], references: [id], onDelete: Restrict)
  course                            Course                            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assignment                        Assignment                        @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  assignmentQuestion                AssignmentQuestion                @relation(fields: [assignmentQuestionId], references: [id], onDelete: Restrict)
  submission                        Submission                        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  studentAnswer                     StudentAnswer                     @relation(fields: [studentAnswerId], references: [id], onDelete: Restrict)
  question                          Question                          @relation("ConceptEvidenceQuestion", fields: [questionId], references: [id], onDelete: Restrict)
  assignmentQuestionConceptSnapshot AssignmentQuestionConceptSnapshot @relation(fields: [assignmentQuestionConceptSnapshotId], references: [id], onDelete: Restrict)
  concept                           KnowledgeGraphConcept             @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  supersedesEvidence                StudentAnswerConceptEvidence?     @relation("ConceptEvidenceSupersession", fields: [supersedesEvidenceId], references: [id], onDelete: Restrict)
  supersededBy                      StudentAnswerConceptEvidence?     @relation("ConceptEvidenceSupersession")

  @@unique([studentAnswerId, conceptId, revision])
  @@index([studentId, courseId, conceptId, revision])
  @@index([studentAnswerId, revision])
  @@index([assignmentQuestionConceptSnapshotId])
  @@index([submissionId])
  @@index([courseId, createdAt])
}

model WrongQuestion {
  id                     String    @id @default(cuid())
  studentId              String
  studentAnswerId        String?   @unique
  assignmentQuestionId   String?
  recommendationAnswerId String?   @unique
  questionId             String?
  isResolved             Boolean   @default(false)
  reviewCount            Int       @default(0)
  wrongCount             Int       @default(1)
  firstWrongAt           DateTime  @default(now())
  lastWrongAt            DateTime  @default(now())
  lastReviewedAt         DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  student              User                          @relation("WrongQuestionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  studentAnswer        StudentAnswer?                @relation(fields: [studentAnswerId], references: [id], onDelete: Restrict)
  assignmentQuestion   AssignmentQuestion?           @relation(fields: [assignmentQuestionId], references: [id], onDelete: Restrict)
  recommendationAnswer RecommendationPracticeAnswer? @relation("RecommendationWrongAnswer", fields: [recommendationAnswerId], references: [id], onDelete: SetNull)
  sourceQuestion       Question?                     @relation("WrongQuestionSourceQuestion", fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([studentId, questionId])
  @@index([studentId, isResolved, firstWrongAt])
  @@index([assignmentQuestionId])
  @@index([questionId, isResolved])
}

model StudentKnowledgeMastery {
  id               String       @id @default(cuid())
  studentId        String
  knowledgePointId String
  level            MasteryLevel @default(NOT_STARTED)
  trend            MasteryTrend @default(UNKNOWN)
  masteryScore     Decimal      @default(0) @db.Decimal(5, 2)
  earnedPoints     Decimal      @default(0) @db.Decimal(12, 2)
  availablePoints  Decimal      @default(0) @db.Decimal(12, 2)
  answeredCount    Int          @default(0)
  correctCount     Int          @default(0)
  calculatedAt     DateTime     @default(now())
  sourceStartedAt  DateTime?
  sourceEndedAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  student        User           @relation("MasteryStudent", fields: [studentId], references: [id], onDelete: Restrict)
  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)

  @@unique([studentId, knowledgePointId])
  @@index([studentId, level, masteryScore])
  @@index([knowledgePointId, masteryScore])
}

model StudentCourseConceptMasteryState {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   User                                  @relation("CourseConceptMasteryStudent", fields: [studentId], references: [id], onDelete: Restrict)
  course    Course                                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  revisions StudentCourseConceptMasteryRevision[]

  @@unique([studentId, courseId])
  @@index([courseId, studentId])
}

model StudentCourseConceptMasteryRevision {
  id                     String   @id @default(cuid())
  stateId                String
  revisionNumber         Int
  inputFingerprint       String   @db.Char(64)
  calculationRuleVersion String   @db.VarChar(50)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  state   StudentCourseConceptMasteryState   @relation(fields: [stateId], references: [id], onDelete: Restrict)
  entries StudentCourseConceptMasteryEntry[]

  @@unique([stateId, revisionNumber])
  @@unique([stateId, inputFingerprint])
  @@index([stateId, createdAt])
}

model StudentCourseConceptMasteryEntry {
  id                  String                    @id @default(cuid())
  masteryRevisionId   String
  conceptId           String
  evidenceCount       Int
  distinctAnswerCount Int
  earnedPoints        Decimal                   @db.Decimal(14, 4)
  availablePoints     Decimal                   @db.Decimal(14, 4)
  masteryScore        Decimal                   @db.Decimal(5, 2)
  level               CourseConceptMasteryLevel
  firstEvidenceAt     DateTime
  lastEvidenceAt      DateTime
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  masteryRevision StudentCourseConceptMasteryRevision @relation(fields: [masteryRevisionId], references: [id], onDelete: Restrict)
  concept         KnowledgeGraphConcept               @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  @@unique([masteryRevisionId, conceptId])
  @@index([conceptId, masteryScore])
  @@index([masteryRevisionId, level])
}

model AIAnalysis {
  id            String          @id @default(cuid())
  requestKey    String          @unique
  requestedById String
  studentId     String?
  classroomId   String?
  scope         AIAnalysisScope
  status        AIRecordStatus  @default(PENDING)
  riskLevel     RiskLevel       @default(UNKNOWN)
  summary       String?         @db.Text
  overallScore  Decimal?        @db.Decimal(5, 2)
  sampleSize    Int             @default(0)
  basedOnFrom   DateTime?
  basedOnTo     DateTime?
  provider      String?
  model         String?
  promptVersion String
  retryCount    Int             @default(0)
  fallbackUsed  Boolean         @default(false)
  inputMetrics  Json?
  rawResponse   Json?
  errorCode     String?
  latencyMs     Int?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  requestedBy     User                         @relation("AIAnalysisRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  student         User?                        @relation("AIAnalysisStudent", fields: [studentId], references: [id], onDelete: Restrict)
  classroom       Classroom?                   @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  insights        AIAnalysisInsight[]
  recommendations PersonalizedRecommendation[]

  @@index([studentId, status, createdAt])
  @@index([classroomId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([scope, riskLevel, createdAt])
  @@index([status, createdAt])
}

model AIAnalysisInsight {
  id                String        @id @default(cuid())
  analysisId        String
  knowledgePointId  String?
  type              AIInsightType
  title             String
  detail            String        @db.Text
  priority          Int           @default(0)
  metricName        String?
  metricValue       Decimal?      @db.Decimal(12, 4)
  recommendedAction String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  analysis       AIAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  knowledgePoint KnowledgePoint? @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)

  @@index([analysisId, type, priority])
  @@index([knowledgePointId, type])
}

model PersonalizedRecommendation {
  id               String               @id @default(cuid())
  studentId        String
  questionId       String
  knowledgePointId String?
  analysisId       String?
  cycleKey         String
  source           RecommendationSource
  status           RecommendationStatus @default(PENDING)
  reason           String               @db.Text
  targetDifficulty Int
  priority         Int                  @default(0)
  expiresAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  dismissedAt      DateTime?
  wasCorrect       Boolean?
  score            Decimal?             @db.Decimal(8, 2)
  maxScore         Decimal?             @db.Decimal(8, 2)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  student        User                          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  question       Question                      @relation(fields: [questionId], references: [id], onDelete: Restrict)
  knowledgePoint KnowledgePoint?               @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)
  analysis       AIAnalysis?                   @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  practiceAnswer RecommendationPracticeAnswer?

  @@unique([studentId, questionId, cycleKey])
  @@index([studentId, status, priority, createdAt])
  @@index([knowledgePointId, status])
  @@index([analysisId])
  @@index([createdAt])
}

model RecommendationPracticeAnswer {
  id                String   @id @default(cuid())
  recommendationId  String   @unique
  questionId        String
  idempotencyKey    String   @unique
  textAnswer        String?  @db.Text
  booleanAnswer     Boolean?
  selectedOptionIds String[] @default([])
  responseTimeMs    Int?
  score             Decimal  @db.Decimal(8, 2)
  maxScore          Decimal  @db.Decimal(8, 2)
  isCorrect         Boolean
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recommendation PersonalizedRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  question       Question                   @relation("RecommendationPracticeQuestion", fields: [questionId], references: [id], onDelete: Restrict)
  wrongQuestion  WrongQuestion?             @relation("RecommendationWrongAnswer")

  @@index([questionId, isCorrect])
  @@index([createdAt])
}

model AITutoringRecord {
  id               String         @id @default(cuid())
  requestKey       String         @unique
  studentId        String
  questionId       String
  knowledgePointId String?
  status           AIRecordStatus @default(PENDING)
  prompt           String         @db.Text
  answer           String?        @db.Text
  explanationSteps String[]       @default([])
  hints            String[]       @default([])
  provider         String?
  model            String?
  promptVersion    String
  retryCount       Int            @default(0)
  fallbackUsed     Boolean        @default(false)
  confidence       Decimal?       @db.Decimal(5, 4)
  safetyFlagged    Boolean        @default(false)
  inputContext     Json?
  rawResponse      Json?
  errorCode        String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  student        User            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  knowledgePoint KnowledgePoint? @relation(fields: [knowledgePointId], references: [id], onDelete: Restrict)

  @@index([studentId, questionId, createdAt])
  @@index([status, createdAt])
  @@index([knowledgePointId, createdAt])
}
