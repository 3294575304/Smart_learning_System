  graphDraft              KnowledgeGraphDraft             @relation(fields: [graphDraftId], references: [id], onDelete: Restrict)
  sourceSyllabusStructure PublishedSyllabusStructure      @relation(fields: [sourceSyllabusStructureId], references: [id], onDelete: Restrict)
  editedBy                User                            @relation("KnowledgeGraphReviewEditedBy", fields: [editedById], references: [id], onDelete: Restrict)
  publishedVersion        PublishedKnowledgeGraphVersion?

  @@unique([graphDraftId, revisionNumber])
  @@index([courseId, createdAt])
  @@index([editedById, createdAt])
}

model PublishedKnowledgeGraphVersion {
  id                        String   @id @default(cuid())
  courseId                  String
  sourceSyllabusStructureId String
  graphDraftId              String
  reviewRevisionId          String   @unique
  publishedById             String
  versionNumber             Int
  structureJson             Json
  publishedAt               DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  course                       Course                              @relation("PublishedKnowledgeGraphCourse", fields: [courseId], references: [id], onDelete: Restrict)
  currentForCourse             Course?                             @relation("CurrentPublishedKnowledgeGraph")
  sourceSyllabusStructure      PublishedSyllabusStructure          @relation(fields: [sourceSyllabusStructureId], references: [id], onDelete: Restrict)
  graphDraft                   KnowledgeGraphDraft                 @relation(fields: [graphDraftId], references: [id], onDelete: Restrict)
  reviewRevision               KnowledgeGraphReviewRevision        @relation(fields: [reviewRevisionId], references: [id], onDelete: Restrict)
  publishedBy                  User                                @relation("KnowledgeGraphPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  nodes                        PublishedKnowledgeGraphNode[]
  edges                        PublishedKnowledgeGraphEdge[]
