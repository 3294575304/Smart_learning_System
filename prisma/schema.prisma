model User {
  id                 String     @id @default(cuid())
  email              String?    @unique
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  profile                            UserProfile?
  taughtClassrooms                   Classroom[]                          @relation("ClassroomTeacher")
  taughtCourses                      Course[]                             @relation("CourseTeacher")
  classMemberships                   ClassMembership[]                    @relation("ClassMembershipStudent")
  createdQuestions                   Question[]                           @relation("QuestionCreator")
  createdKnowledgePoints             KnowledgePoint[]                     @relation("KnowledgePointCreator")
  assignments                        Assignment[]                         @relation("AssignmentTeacher")
  submissions                        Submission[]                         @relation("SubmissionStudent")
  gradedAnswers                      StudentAnswer[]                      @relation("StudentAnswerGrader")
  wrongQuestions                     WrongQuestion[]                      @relation("WrongQuestionStudent")
  knowledgeMasteries                 StudentKnowledgeMastery[]            @relation("MasteryStudent")
  requestedAIAnalyses                AIAnalysis[]                         @relation("AIAnalysisRequester")
  studentAIAnalyses                  AIAnalysis[]                         @relation("AIAnalysisStudent")
  personalizedRecommendations        PersonalizedRecommendation[]
  aiTutoringRecords                  AITutoringRecord[]
  authSessions                       AuthSession[]
  auditLogs                          AuditLog[]                           @relation("AuditActor")
  updatedSystemConfigs               SystemConfig[]                       @relation("SystemConfigUpdater")
  notifications                      Notification[]                       @relation("NotificationRecipient")
  createdAnnouncements               Announcement[]                       @relation("AnnouncementCreator")
  publishedAnnouncements             Announcement[]                       @relation("AnnouncementPublisher")
  uploadedCourseFiles                CourseFileVersion[]                  @relation("CourseFileUploadedBy")
  uploadedCourseSyllabi              CourseSyllabus[]                     @relation("CourseSyllabusUploadedBy")
  requestedSyllabusParses            SyllabusParseDraft[]                 @relation("SyllabusParseRequestedBy")
  syllabusReviewRevisions            SyllabusReviewRevision[]             @relation("SyllabusReviewEditedBy")
  publishedSyllabusStructures        PublishedSyllabusStructure[]         @relation("SyllabusStructurePublishedBy")
  requestedKnowledgeGraphDrafts      KnowledgeGraphDraft[]                @relation("KnowledgeGraphDraftRequestedBy")
  knowledgeGraphReviewRevisions      KnowledgeGraphReviewRevision[]       @relation("KnowledgeGraphReviewEditedBy")
  publishedKnowledgeGraphs           PublishedKnowledgeGraphVersion[]     @relation("KnowledgeGraphPublishedBy")
  createdQuestionGraphBindings       QuestionKnowledgeGraphBinding[]      @relation("QuestionGraphBindingCreator")
  conceptAnswerEvidences             StudentAnswerConceptEvidence[]       @relation("ConceptEvidenceStudent")
  courseConceptMasteryStates         StudentCourseConceptMasteryState[]   @relation("CourseConceptMasteryStudent")
  createdStudentImportBatches        StudentImportBatch[]                 @relation("StudentImportBatchCreatedBy")
  matchedStudentImportRows           StudentImportRow[]                   @relation("StudentImportMatchedUser")
  createdStudentImportRows           StudentImportRow[]                   @relation("StudentImportCreatedUser")
  studentIdentity                    StudentIdentity?
  createdAssessmentSchemeDrafts      AssessmentSchemeDraft[]              @relation("AssessmentSchemeDraftCreatedBy")
  assessmentSchemeReviews            AssessmentSchemeReviewRevision[]     @relation("AssessmentSchemeReviewEditedBy")
  publishedAssessmentSchemes         PublishedAssessmentScheme[]          @relation("AssessmentSchemePublishedBy")
  createdGradebooks                  CourseGradebook[]                    @relation("GradebookCreatedBy")
  studentGradeEntries                StudentGradeEntry[]                  @relation("StudentGradeEntries")
  studentGradeEntryRevisions         StudentGradeEntryRevision[]          @relation("StudentGradeEntryRevisions")
  changedGradeEntryRevisions         StudentGradeEntryRevision[]          @relation("GradeEntryRevisionChangedBy")
  studentFinalGradeOverrides         StudentFinalGradeOverride[]          @relation("StudentFinalGradeOverrides")
  studentFinalGradeOverrideRevisions StudentFinalGradeOverrideRevision[]  @relation("StudentFinalGradeOverrideRevisions")
  changedFinalGradeOverrides         StudentFinalGradeOverrideRevision[]  @relation("FinalGradeOverrideChangedBy")
  studentCourseGradeStates           StudentCourseGradeState[]            @relation("StudentCourseGradeStates")
  studentCourseGradeRevisions        StudentCourseGradeRevision[]         @relation("StudentCourseGradeRevisions")
  calculatedCourseGradeRevisions     StudentCourseGradeRevision[]         @relation("CourseGradeCalculatedBy")
  publishedGradebooks                GradebookPublication[]               @relation("GradebookPublishedBy")
  gradebookPublicationRows           GradebookPublicationStudent[]        @relation("GradebookPublicationStudents")
  createdGradeImportBatches          GradeImportBatch[]                   @relation("GradeImportCreatedBy")
  matchedGradeImportRows             GradeImportRow[]                     @relation("GradeImportMatchedStudent")
  createdAttendanceSessions          AttendanceSession[]                  @relation("AttendanceSessionTeacher")
  studentAttendanceRecords           AttendanceRecord[]                   @relation("AttendanceRecordStudent")
  attendanceRecordRevisions          AttendanceRecordRevision[]           @relation("AttendanceRevisionActor")
  generatedOutcomeAttainmentRuns     CourseOutcomeAttainmentRun[]         @relation("OutcomeAttainmentGeneratedBy")
  studentOutcomeAttainmentResults    StudentOutcomeAttainmentResult[]     @relation("OutcomeAttainmentStudent")
  requestedBackgroundJobs            BackgroundJob[]                      @relation("BackgroundJobRequester")
  learningEvents                     LearningEvent[]                      @relation("LearningEventStudent")
  programmingConfigRevisions         ProgrammingQuestionConfigRevision[]  @relation("ProgrammingConfigCreatedBy")
  programmingAttempts                ProgrammingAttempt[]                 @relation("ProgrammingAttemptStudent")
  createdProgrammingAttempts         ProgrammingAttempt[]                 @relation("ProgrammingAttemptCreatedBy")
  learnerProfileSnapshots            LearnerProfileSnapshot[]             @relation("LearnerProfileStudent")
  createdAIQuestionMappingBatches    AIQuestionMappingBatch[]             @relation("AIQuestionMappingBatchCreator")
  createdTeachingProgressRevisions   CourseTeachingProgressRevision[]     @relation("CourseTeachingProgressCreatedBy")
  createdRecommendationPolicies      CourseRecommendationPolicyRevision[] @relation("CourseRecommendationPolicyCreatedBy")
  courseRecommendationCycles         CourseRecommendationCycle[]          @relation("CourseRecommendationStudent")
  recommendationConceptEvidences     RecommendationConceptEvidence[]      @relation("RecommendationConceptEvidenceStudent")
  selfReflections                    StudentSelfReflection[]              @relation("StudentSelfReflectionStudent")
  requestedQualityReports            CourseQualityReport[]                @relation("QualityReportRequestedBy")
  reviewedQualityReports             CourseQualityReport[]                @relation("QualityReportReviewedBy")
  createdCourseSurveys               CourseSurvey[]                       @relation("CourseSurveyTeacher")
  courseSurveyParticipations         CourseSurveyParticipation[]          @relation("CourseSurveyParticipant")
  identifiedCourseSurveyResponses    CourseSurveyResponse[]               @relation("CourseSurveyIdentifiedRespondent")

  @@index([role, status])
  @@index([mustChangePassword])
  @@index([createdAt])
}

model Notification {
  id               String                 @id @default(cuid())
  recipientId      String
  type             NotificationType
  title            String                 @db.VarChar(100)
  content          String                 @db.Text
  priority         NotificationPriority   @default(NORMAL)
  actionUrl        String?                @db.VarChar(500)
  sourceType       NotificationSourceType
  sourceId         String                 @db.VarChar(128)
  deduplicationKey String                 @db.VarChar(191)
  readAt           DateTime?
  expiresAt        DateTime?
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([recipientId, deduplicationKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([expiresAt])
  @@index([sourceType, sourceId])
}

model Announcement {
  id            String                 @id @default(cuid())
  title         String                 @db.VarChar(100)
  content       String                 @db.Text
  targetType    AnnouncementTargetType
  status        AnnouncementStatus     @default(DRAFT)
  createdById   String
  publishedById String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  createdBy   User  @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User? @relation("AnnouncementPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([targetType, status])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([createdById])
  @@index([publishedById])
}

model NotificationJobRun {
  id           String                @id @default(cuid())
  type         NotificationJobType
  status       NotificationJobStatus
  scannedCount Int                   @default(0)
  createdCount Int                   @default(0)
  skippedCount Int                   @default(0)
  failedCount  Int                   @default(0)
  errorSummary String?               @db.VarChar(500)
  startedAt    DateTime              @default(now())
  completedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([type, startedAt])
  @@index([status, startedAt])
}

model BackgroundJob {
  id                String              @id @default(cuid())
  type              String              @db.VarChar(100)
  status            BackgroundJobStatus @default(PENDING)
  requestedById     String?
  courseId          String?
  idempotencyKey    String              @db.VarChar(191)
  inputFingerprint  String              @db.Char(64)
  input             Json
  progress          Int                 @default(0)
  attemptCount      Int                 @default(0)
  maxAttempts       Int                 @default(3)
  nextAttemptAt     DateTime            @default(now())
  currentLeaseId    String?             @db.VarChar(64)
  errorCode         String?             @db.VarChar(100)
  retryable         Boolean?
  result            Json?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  requestedBy        User?                  @relation("BackgroundJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  course             Course?                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  attempts           BackgroundJobAttempt[]
  programmingAttempt ProgrammingAttempt?
  qualityReport      CourseQualityReport?

  @@unique([type, idempotencyKey])
  @@index([status, nextAttemptAt, createdAt])
  @@index([courseId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([currentLeaseId])
}

model BackgroundJobAttempt {
  id              String    @id @default(cuid())
  jobId           String
  attemptNumber   Int
  leaseId         String    @unique @db.VarChar(64)
  workerId        String    @db.VarChar(191)
  executorVersion String    @db.VarChar(100)
  startedAt       DateTime  @default(now())
  heartbeatAt     DateTime  @default(now())
  expiresAt       DateTime
  completedAt     DateTime?
  errorCode       String?   @db.VarChar(100)
  retryable       Boolean?
  resourceUsage   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
  @@index([expiresAt, completedAt])
  @@index([workerId, startedAt])
}

model SystemConfig {
  id                        String   @id @default(cuid())
  singletonKey              String   @unique @default("default")
  platformName              String   @default("智学课堂")
  platformAnnouncement      String   @default("") @db.Text
  maintenanceMode           Boolean  @default(false)
  maintenanceMessage        String   @default("系统维护中，请稍后再试。")
  allowSelfRegistration     Boolean  @default(true)
  assignmentDefaultDueDays  Int      @default(7)
  assignmentAutosaveDelayMs Int      @default(900)
  aiAnalysisEnabled         Boolean  @default(true)
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  updatedBy User? @relation("SystemConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model AuditLog {
  id         String          @id @default(cuid())
  actorId    String
  action     AuditAction
  targetType AuditTargetType
  targetId   String
  summary    String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  avatarUrl   String?
  bio         String?  @db.Text
  phone       String?
  studentNo   String?  @unique
  teacherNo   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

model StudentIdentity {
  id        String                @id @default(cuid())
  studentNo String                @unique @db.VarChar(50)
  name      String                @db.VarChar(100)
  email     String?               @db.VarChar(254)
  status    StudentIdentityStatus @default(PENDING)
  userId    String?               @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user        User?                                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments StudentIdentityClassroomAssignment[]
