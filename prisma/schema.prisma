  status            ClassroomStatus @default(ACTIVE)
  closedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  teacher                    User                                 @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  course                     Course?                              @relation("ClassroomCourse", fields: [courseId], references: [id], onDelete: SetNull)
