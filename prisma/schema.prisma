  sourceFileMimeType        String                   @db.VarChar(100)
  sourceFileSizeBytes       Int
  sourceSheetName           String?                  @db.VarChar(100)
  mappingConfig             Json
  previewSummary            Json?
  totalRows                 Int                      @default(0)
  previewRows               Int                      @default(0)
  newUserRows               Int                      @default(0)
  existingUserRows          Int                      @default(0)
  alreadyEnrolledRows       Int                      @default(0)
