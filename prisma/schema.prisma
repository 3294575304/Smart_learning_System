  publishedAssignmentSnapshots AssignmentQuestionConceptSnapshot[] @relation("AssignmentConceptSnapshotPublishedVersion")

  @@unique([courseId, versionNumber])
  @@index([courseId, publishedAt])
  @@index([sourceSyllabusStructureId])
}

model KnowledgeGraphConcept {
  id        String   @id @default(cuid())
  courseId  String
  stableKey String   @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course                      Course                              @relation(fields: [courseId], references: [id], onDelete: Restrict)
